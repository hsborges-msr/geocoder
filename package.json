{
  "name": "@hsborges-msr/geocoder",
  "version": "6.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsborges-msr/geocoder.git"
  },
  "main": "./packages/core/dist/index.js",
  "exports": "./packages/core/dist/index.js",
  "types": "./packages/core/dist/index.d.ts",
  "bin": {
    "geocoder": "./packages/cli/dist/cli.js"
  },
  "type": "module",
  "files": ["packages/core/dist", "packages/cli/dist", "package.json", "README.md"],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": ["packages/core", "packages/cli"],
  "scripts": {
    "prepare": "husky || true",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "biome format --write .",
    "test": "turbo test",
    "verify": "turbo lint test typecheck build",
    "prepack": "turbo build",
    "release": "release-it"
  },
  "dependencies": {
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@keyv/compress-brotli": "^2.0.5",
    "@keyv/sqlite": "^4.0.8",
    "cache-manager": "^7.2.7",
    "consola": "^3.4.2",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "keyv": "^5.5.5",
    "p-queue": "^9.0.1",
    "quick-lru": "^7.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/bumper": "^8.0.0",
    "@tsconfig/node20": "^20.1.8",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "auto-changelog": "^2.6.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv-flow": "^4.1.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "release-it": "^21.0.2",
    "shx": "^0.4.0",
    "tsc-alias": "^1.9.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.0",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "basic-ftp": "^6.2.1",
    "sqlite3": "^6.0.1",
    "undici": "^7.29.1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "release-it": {
    "npm": {
      "publish": false
    },
    "git": {
      "commit": true,
      "commitMessage": "chore(release): v${version}",
      "tag": true,
      "tagName": "v${version}",
      "push": true,
      "requireCleanWorkingDir": false
    },
    "github": {
      "web": true,
      "autoGenerate": true,
      "release": true,
      "releaseName": "v${version}"
    },
    "hooks": {
      "before:init": ["turbo lint test"],
      "after:bump": [
        "yarn format",
        "yarn install",
        "turbo build",
        "git add packages/core/package.json packages/cli/package.json"
      ]
    },
    "plugins": {
      "@release-it/bumper": {
        "out": ["packages/core/package.json", "packages/cli/package.json"]
      }
    }
  }
}