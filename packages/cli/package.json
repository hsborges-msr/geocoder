{
  "name": "@hsborges-msr/geocoder-cli",
  "version": "6.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsborges-msr/geocoder.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hsborges-msr/geocoder#readme",
  "bugs": {
    "url": "https://github.com/hsborges-msr/geocoder/issues"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "geocoder": "./dist/cli.js"
  },
  "scripts": {
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "format": "biome format --write ./src",
    "build": "shx rm -rf dist && tsup-node --config tsup.config.mjs src/cli.ts --minify --format esm --clean",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch -r \"dotenv-flow/config\" src/cli.ts",
    "start": "node -r \"dotenv-flow/config\" dist/cli.js",
    "prepack": "npx shx cp ../../README.md dist"
  },
  "dependencies": {
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@hsborges-msr/geocoder": "file:../core",
    "@keyv/sqlite": "^4.0.8",
    "commander": "^15.0.0",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.2.1"
  }
}