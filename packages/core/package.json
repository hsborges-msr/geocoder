{
  "name": "@hsborges-msr/geocoder",
  "version": "5.8.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/hsborges-msr/geocoder.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hsborges-msr/geocoder#readme",
  "bugs": {
    "url": "https://github.com/hsborges-msr/geocoder/issues"
  },
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "format": "biome format --write ./src",
    "build:clean": "shx rm -rf dist tsconfig.tsbuildinfo",
    "build:bundle": "tsup-node src/index.ts --minify --format esm --clean",
    "build:definitions": "tsc --emitDeclarationOnly",
    "build": "run-s build:clean build:bundle build:definitions",
    "test": "vitest run src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@keyv/compress-brotli": "^2.0.5",
    "cache-manager": "^7.2.7",
    "debug": "^4.4.3",
    "keyv": "^5.5.5",
    "ky": "^2.1.0",
    "p-queue": "^9.0.1",
    "quick-lru": "^7.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@vitest/coverage-v8": "^5.0.0",
    "nock": "^14.0.10",
    "vitest": "^5.0.0"
  },
  "files": ["dist", "package.json", "README.md"]
}